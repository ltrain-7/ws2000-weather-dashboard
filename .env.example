# Required: create both keys at https://ambientweather.net/account
AMBIENT_APPLICATION_KEY=replace-with-your-application-key
AMBIENT_API_KEY=replace-with-your-api-key

# Optional station selection. Leave blank to use the first station.
# AMBIENT_DEVICE_MAC=00:00:00:00:00:00

# Balanced defaults suitable for Raspberry Pi 3/4/5 and most NAS devices.
TZ=America/New_York
# Calendar days, rainfall totals, date-picker ranges, and chart labels use this
# IANA timezone. It defaults to TZ when omitted.
STATION_TIMEZONE=America/New_York
DASHBOARD_PORT=3000
WS2000_IMAGE=ghcr.io/ltrain-7/ws2000-weather-dashboard:stable
AMBIENT_POLL_INTERVAL_MS=120000
AMBIENT_HISTORY_LIMIT=96
HISTORY_MAX_POINTS=480
LIVE_HISTORY_LIMIT=192
HISTORY_RETENTION_DAYS=365
CONTAINER_MEMORY_LIMIT=256m
CONTAINER_CPU_LIMIT=1.0
LOG_MAX_SIZE=5m
LOG_MAX_FILES=2
STATION_STALE_MINUTES=15
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=90
BACKUP_MAX_FILES=12

# Optional administrator login. Generate the hash with:
# docker compose run --rm ws2000-dashboard node scripts/hash-admin-password.js
ADMIN_AUTH_ENABLED=false
ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH='scrypt$...'
# ADMIN_PASSWORD_HASH_FILE=/app/secrets/admin-password.hash
ADMIN_SESSION_TTL_MINUTES=480
# Set true only when DSM, Caddy, or another trusted local reverse proxy
# terminates HTTPS and overwrites X-Forwarded-Proto.
ADMIN_TRUST_PROXY=false

# Optional native TLS, mainly for Raspberry Pi/Linux. On Synology, leave this
# false and let DSM's reverse proxy manage HTTPS and certificate renewal.
TLS_ENABLED=false
TLS_CERT_PATH=/app/certs/fullchain.pem
TLS_KEY_PATH=/app/certs/privkey.pem
