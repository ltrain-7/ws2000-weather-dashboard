# Raspberry Pi 4/5 with 2 GB or more, mini PC, or NAS
AMBIENT_APPLICATION_KEY=replace-with-your-application-key
AMBIENT_API_KEY=replace-with-your-api-key
TZ=America/New_York
DASHBOARD_PORT=3000
WS2000_IMAGE=ghcr.io/ltrain-7/ws2000-weather-dashboard:stable
AMBIENT_POLL_INTERVAL_MS=60000
AMBIENT_HISTORY_LIMIT=288
HISTORY_MAX_POINTS=720
LIVE_HISTORY_LIMIT=288
HISTORY_RETENTION_DAYS=730
CONTAINER_MEMORY_LIMIT=384m
CONTAINER_CPU_LIMIT=2.0
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
