# Raspberry Pi Zero 2 W / 512 MB profile
AMBIENT_APPLICATION_KEY=replace-with-your-application-key
AMBIENT_API_KEY=replace-with-your-api-key
TZ=America/New_York
DASHBOARD_PORT=3000
WS2000_IMAGE=ghcr.io/ltrain-7/ws2000-weather-dashboard:stable
AMBIENT_POLL_INTERVAL_MS=300000
AMBIENT_HISTORY_LIMIT=48
HISTORY_MAX_POINTS=240
LIVE_HISTORY_LIMIT=96
HISTORY_RETENTION_DAYS=90
CONTAINER_MEMORY_LIMIT=160m
LOG_MAX_SIZE=2m
LOG_MAX_FILES=2
